# ============================================================
# Delta Neutral Engine - Environment Configuration Template
# DO NOT COMMIT REAL PRIVATE KEYS OR API KEYS TO GIT
# ============================================================

ENVIRONMENT=TESTNET
ENABLE_LIVE_TRADING=0

# ---- WALLET A (Starknet L2 Account) ----
WALLET_A_VAULT_ID=your_wallet_a_vault_id
WALLET_A_PUBLIC_KEY=0x_your_wallet_a_public_key
WALLET_A_PRIVATE_KEY=0x_your_wallet_a_private_key
WALLET_A_API_KEY=your_wallet_a_api_key

# ---- WALLET B (Starknet L2 Account) ----
WALLET_B_VAULT_ID=your_wallet_b_vault_id
WALLET_B_PUBLIC_KEY=0x_your_wallet_b_public_key
WALLET_B_PRIVATE_KEY=0x_your_wallet_b_private_key
WALLET_B_API_KEY=your_wallet_b_api_key

# ---- EXECUTION CONTROLS ----
HEDGE_MAX_RETRIES=3
MAX_CROSS_TICKS=2
MAX_CROSS_BPS=2
MAKER_WAIT_SEC=42
EXIT_TIMEOUT_SEC=52
ORDER_POLL_SEC=0.05

# ---- MARKETS ENABLED ----
ENABLE_HYPE=1
ENABLE_BTC=1
ENABLE_BNB=1
ENABLE_XAG=1

# ---- CONCURRENCY & CAPITAL GATES ----
MAX_CONCURRENT_MARKETS=2
MARKET_COOLDOWN_SEC=81
MARGIN_FRACTION=0.40
RESERVE_USDC=3.5
MAX_MARGIN_USDC=43
